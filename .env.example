# ============================================================
#  Social Agent — maxfiy sozlamalar
#  Bu faylni nusxalang:  copy .env.example .env   va to'ldiring
# ============================================================

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Telegram shaxsiy akkaunt (userbot) — https://my.telegram.org -> API development tools ---
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/userbot

# --- Telegram admin-bot (@BotFather dan token oling) ---
ADMIN_BOT_TOKEN=
# Admin(lar)ning Telegram ID raqami, vergul bilan (ID ni @userinfobot dan bilish mumkin)
ADMIN_IDS=

# --- Veb-dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# --- Ma'lumotlar bazasi ---
DATABASE_URL=sqlite:///data/agent.db

# --- Video fabrikasi (ixtiyoriy — kalitsiz ham ffmpeg+edge-tts ishlaydi) ---
PEXELS_API_KEY=
GEMINI_VEO_MODEL=veo-2.0-generate-001
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
# Instagram Reels yuklash uchun videoga tashqi HTTPS havola kerak (masalan VPS domeni yoki ngrok)
PUBLIC_MEDIA_BASE_URL=

# --- YouTube Data API (Google Cloud Console -> OAuth 2.0 Desktop client JSON) ---
YT_CLIENT_SECRETS=data/youtube_client_secret.json
YT_TOKEN_FILE=data/youtube_token.json
YT_DEFAULT_PRIVACY=private

# --- Instagram Graph API (Business/Creator akkaunt + Facebook Page) ---
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# --- Targetolog: Meta Ads & Google Ads (pul amallari DOIM tasdiq so'raydi!) ---
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

